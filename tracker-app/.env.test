APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true

# The Speed Fix: Use a physical file to allow Transaction-based RefreshDatabase
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Efficiency Fixes: Prevent disk I/O for temporary data
CACHE_STORE=array
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Auth Speed Fix: Minimum CPU work for password hashing
BCRYPT_ROUNDS=4

# Disable unnecessary services for testing
MAIL_MAILER=array
TELESCOPE_ENABLED=false
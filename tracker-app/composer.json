{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/apiclient": "^2.18",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.11",
        "kreait/laravel-firebase": "^7.1",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.10.1",
        "spatie/calendar-links": "^2.0",
        "symfony/css-selector": "^8.0",
        "symfony/dom-crawler": "^8.0",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.8",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "reliese/laravel": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Hyperdrive\\": "packages/hyperdrive/src/",
            "Fabricator\\": "packages/fabricator/src/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint:format": [
            "pint app/helpers.php",
            "pint app/Bus",
            "pint app/Channels",
            "pint app/Console",
            "pint app/Contracts",
            "pint app/Enums",
            "pint app/Facades",
            "pint app/Features",
            "pint app/Helpers",
            "pint app/Http",
            "pint app/Jobs",
            "pint app/Mail",
            "pint app/Messages",
            "pint app/Models/Casts",
            "pint app/Models/Concerns",
            "pint app/Models/Filters",
            "pint app/Models/Observers",
            "pint app/Notifications",
            "pint app/Policies",
            "pint app/Providers",
            "pint app/Rules",
            "pint app/Services"
        ],
        "pint:test": "@pint:format --test",
        "db:migrate-all": [
            "@db:regen",
            "@php artisan db:seed --class=FloridaGarrisonSeeder"
        ],
        "db:regen": [
            "@php artisan migrate:rollback --force",
            "@php artisan migrate",
            "@php artisan code:model",
            "@php artisan fabricator:generate-factories"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:ci": [
            "@php artisan config:clear --ansi",
            "@php -d display_errors=1 -d error_reporting=E_ALL vendor/bin/phpunit --testdox --stop-on-failure"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
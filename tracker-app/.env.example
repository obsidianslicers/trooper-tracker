APP_NAME='Troop Tracker'
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

TRACKER_SUPPORT_GOAL=300
TRACKER_SUPPORT_URL=https://www.example.com/
TRACKER_CALENDAR_TIMEZONE=America/New_York
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=trooptracker
DB_USERNAME=root
DB_PASSWORD=X

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS='hello@example.com'
MAIL_FROM_NAME=''

# SOCIALITE CONFIGURATION
# OAuth credentials for external authentication providers.
# These values enable login via Google and XenForo. Replace the placeholders
# with your app’s client IDs, secrets, and callback URLs when configuring
# authentication in your environment.
GOOGLE_CLIENT_ID='xxxx'
GOOGLE_CLIENT_SECRET='xxxx'
GOOGLE_REDIRECT_URI='http://localhost:8000/oauth/google/callback'

XENFORO_CLIENT_ID='xxxx'
XENFORO_CLIENT_SECRET='xxxx'
XENFORO_REDIRECT_URI='http://localhost:8000/oauth/xenforo/callback'
XENFORO_BASE_URL='https://forum.example.com'
XENFORO_NAME='XenForo Forum Name'

# XENFORO API CONFIGURATION
XENFORO_API_KEY='xxxx'
XENFORO_API_USER=1
XENFORO_AUTHORIZE_PATH=/index.php?oauth2/authorize
XENFORO_TOKEN_PATH=/index.php?api/oauth2/token
XENFORO_ME_PATH=/api/me
TRACKER_REQUIRE_XENFORO=false

# DISCORD WEBHOOK (for notifications)
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/
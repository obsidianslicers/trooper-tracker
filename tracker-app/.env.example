################################################################################
# Troop Tracker (.env.example)
#
# Copy this file to `.env` and update values for your environment.
#
# Notes:
# - Never commit real secrets (APP_KEY, DB_PASSWORD, OAuth secrets, API keys).
# - For full variable reference, see `docs/ENVIRONMENT_VARIABLES.md`.
################################################################################

########################################
# App basics
########################################

APP_NAME='Troop Tracker'
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Required: generate with `php artisan key:generate`.
APP_KEY=base64:CHANGE_ME

# Optional: previous keys for key rotation (comma-separated).
# APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode (generally leave defaults unless you know you need cache).
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

########################################
# Troop Tracker settings
########################################

# Support widget (optional)
TRACKER_SUPPORT_GOAL=300
TRACKER_SUPPORT_URL=https://www.example.com/

# URL of the donor badge image shown on a trooper's profile when they are an active donor.
TRACKER_DONOR_IMAGE_URL=''

# Used for calendar links and exports (ICS)
TRACKER_CALENDAR_TIMEZONE=America/New_York

# Image processing driver (only change if your server supports it)
# Options:
# - Intervention\Image\Drivers\Gd\Driver
# - Intervention\Image\Drivers\Imagick\Driver
# TRACKER_IMAGE_DRIVER='Intervention\\Image\\Drivers\\Gd\\Driver'

########################################
# Security / hashing
########################################

# Higher is slower but more secure.
BCRYPT_ROUNDS=12

########################################
# Logging
########################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

########################################
# Database
########################################

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=trooptracker
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

########################################
# Session / cache / queue
########################################

# Defaults use the database for sessions + cache.
# Ensure you have run migrations if you use `database` drivers.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# Recommended: use `database` and run `php artisan queue:work`.
# If you prefer fully synchronous behavior (no worker), set this to `sync`.
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

########################################
# Mail
########################################

# Local dev typically uses `log`.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS='hello@example.com'
MAIL_FROM_NAME='Troop Tracker'

# Email address shown as a contact fallback on the FAQ page (optional).
CONTACT_EMAIL=

# Optional prefix added to all outgoing email subjects.
MAIL_SUBJECT_PREFIX='[Troop Tracker]'

########################################
# OAuth providers (Laravel Socialite)
########################################

# If you configure a provider, you must set ALL of: CLIENT_ID, CLIENT_SECRET,
# and REDIRECT_URI.
# Redirect URIs should match the app routes:
# - {APP_URL}/oauth/google/callback
# - {APP_URL}/oauth/xenforo/callback

# Google OAuth (optional)
GOOGLE_CLIENT_ID='CHANGE_ME'
GOOGLE_CLIENT_SECRET='CHANGE_ME'
GOOGLE_REDIRECT_URI='http://localhost:8000/oauth/google/callback'

# Used for geocoding event addresses (optional).
# Requires enabling the Google Maps APIs in Google Cloud.
GOOGLE_MAPS_API_KEY=''

# XenForo OAuth (optional, or REQUIRED if TRACKER_REQUIRE_XENFORO=true)
XENFORO_CLIENT_ID='CHANGE_ME'
XENFORO_CLIENT_SECRET='CHANGE_ME'
XENFORO_REDIRECT_URI='http://localhost:8000/oauth/xenforo/callback'
XENFORO_BASE_URL='https://forum.example.com'
XENFORO_NAME='XenForo Forum Name'

# XenForo OAuth endpoint paths (these defaults match XenForo 2.3)
XENFORO_AUTHORIZE_PATH=/index.php?oauth2/authorize
XENFORO_TOKEN_PATH=/index.php?api/oauth2/token
XENFORO_ME_PATH=/api/me

########################################
# XenForo API (threads + comments)
########################################

# Required if you want Troop Tracker to create threads or fetch posts.
XENFORO_API_KEY='CHANGE_ME'

# XenForo API user ID (numeric). Commonly 1 (admin) in small setups.
XENFORO_API_USER=1

########################################
# XenForo-only accounts enforcement
########################################

# When true, Troop Tracker disables email/password login and blocks non-XenForo
# OAuth providers (like Google). It also requires XenForo OAuth for sign up.
#
# IMPORTANT: If you set this to true, you must configure XenForo OAuth above.
TRACKER_REQUIRE_XENFORO=false

# Admin exception notification emails for unhandled 5xx errors.
TRACKER_EXCEPTION_EMAIL_ENABLED=true

########################################
# Firebase (optional — mobile push notifications)
########################################

# Path to your Firebase Admin SDK service account JSON key file.
# Place the file inside tracker-app/ and set the filename here.
# When omitted, push notifications are skipped but in-app notifications still work.
# FIREBASE_CREDENTIALS=your-firebase-adminsdk-key.json

########################################
# Discord notifications
########################################

# Optional: enables event notifications to Discord.
DISCORD_WEBHOOK_URL=''

########################################
# Optional / advanced third-party integrations
########################################

# Postmark (optional)
POSTMARK_API_KEY=''

# Resend (optional)
RESEND_API_KEY=''

# Slack notifications (optional)
SLACK_BOT_USER_OAUTH_TOKEN=''
SLACK_BOT_USER_DEFAULT_CHANNEL=''

################################################################################
# Non-.env setup notes
#
# Google Sheets sync:
# - Place your Google service account credentials at `tracker-app/google-credentials.json`.
# - The admin UI will show Google sync fields only when that file is readable.
################################################################################
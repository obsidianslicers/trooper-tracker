{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "es2019",
        "allowJs": true,
        "checkJs": false,
        "moduleResolution": "bundler",
        "strict": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "$lib/*": [
                "./resources/svelte/lib/*"
            ],
        }
    },
    "include": [
        "resources/svelte/**/*.ts",
        "resources/svelte/**/*.d.ts",
        "resources/svelte/**/*.svelte"
    ]
}